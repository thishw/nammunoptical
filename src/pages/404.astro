---
import Base from '../layouts/Base.astro';
import { store, telHref } from '../data/store';
---
<Base title="페이지를 찾을 수 없습니다 | 남문안경" description="요청하신 페이지를 찾을 수 없습니다. 남문안경 홈으로 이동하거나 전화로 문의해 주세요." noindex>
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">404</p>
      <h1>페이지를 찾을 수 없습니다</h1>
      <p class="lead">주소가 바뀌었거나 삭제된 페이지입니다.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">홈으로</a>
        <a class="btn btn--ghost" href="/location/">오시는 길</a>
        <a class="btn btn--ghost" href={telHref}>{store.phone}</a>
      </div>
    </div>
  </section>
</Base>
