---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import { photos } from '../data/photos';
import { store, walkText } from '../data/store';
const crumbs = [ { name: '홈', path: '/' }, { name: '매장 사진', path: '/gallery/' } ];
const outside = photos.filter((p) => p.group === 'outside').map((p) => p.key);
const inside = photos.filter((p) => p.group === 'inside').map((p) => p.key);
---
<Base
  title="매장 사진 | 부천역 남문안경 외관·내부·안경테 진열"
  description={`부천역 남문안경 매장 사진. 간판과 진열창, 안경테·선글라스 진열장, 상담석과 대기 공간까지 — ${store.landmark}, ${walkText}.`}
  crumbs={crumbs}
>
  <PageHero eyebrow="Gallery" title="남문안경 매장 둘러보기" lead={`${store.landmark}의 남문안경. 방문 전에 간판과 매장 안을 미리 살펴보세요.`} />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">매장 안</p>
        <h2>안경테 진열장과 상담 공간</h2>
      </div>
      <PhotoGrid keys={inside} credit={false} eager />
    </div>
  </section>
  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">매장 밖</p>
        <h2>이 간판을 찾아오세요</h2>
      </div>
      <PhotoGrid keys={outside} />
    </div>
  </section>
  <CtaBand />
</Base>
