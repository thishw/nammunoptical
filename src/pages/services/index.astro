---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
const crumbs = [ { name: '홈', path: '/' }, { name: '서비스', path: '/services/' } ];
---
<Base
  title="서비스 안내 | 시력검사·누진다초점·어린이 안경·콘택트렌즈·선글라스 | 부천역 남문안경"
  description="부천역 남문안경 서비스: 자동굴절검사기·양안시 검사 기반 안경 맞춤, 누진다초점 안경, 어린이·청소년 안경, 아큐브 콘택트렌즈, 도수 선글라스, 피팅."
  crumbs={crumbs}
>
  <PageHero eyebrow="서비스" title="남문안경 서비스 안내" lead="시력검사부터 안경·렌즈·선글라스 선택, 착용 후 피팅까지 한곳에서 도와드립니다." />
  <section class="section">
    <div class="container grid grid--2">
      {services.map((s) => (
        <a class="card" href={`/services/${s.slug}/`}>
          <span class="icon-badge"><Icon name={s.icon} /></span>
          <h2 class="h3">{s.name}</h2>
          <p>{s.lead}</p>
          <span class="more">자세히 보기 <Icon name="arrow" /></span>
        </a>
      ))}
      <a class="card" href="/brands/">
        <span class="icon-badge"><Icon name="glasses" /></span>
        <h2 class="h3">대표 취급 브랜드</h2>
        <p>렌즈 자이스·호야·쇼와 등, 안경테·선글라스 페레가모·오클리·카잘 등 국내외 다수 브랜드를 갖추고 있습니다.</p>
        <span class="more">브랜드 보기 <Icon name="arrow" /></span>
      </a>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .h3 { font-size: 1.2rem; margin-bottom: 8px; }
</style>
