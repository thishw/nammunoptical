---
import Icon from './Icon.astro';
import { store, telHref, formatHours } from '../data/store';
interface Props { title?: string }
const { title = '궁금한 점은 전화로 편하게 물어보세요' } = Astro.props;
---
<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{store.address.short} · {formatHours()} · 주차 가능</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--light" href={telHref}><Icon name="phone" />{store.phone}</a>
      <a class="btn btn--outline-light" href={store.links.naverDirections} target="_blank" rel="noopener noreferrer"><Icon name="route" />길찾기<span class="sr-only"> (새 창)</span></a>
    </div>
  </div>
</section>
<style>
  .cta-band {
    background: var(--green);
    color: #e7efe9;
    padding: clamp(40px, 6vw, 64px) 0;
  }
  .cta-inner {
    display: grid;
    gap: 20px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .cta-inner {
      grid-template-columns: 1fr auto;
    }
  }
  h2 {
    color: #fff;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    margin-bottom: 6px;
  }
  p {
    margin: 0;
  }
  .btn--light {
    background: #fff;
    color: var(--green);
  }
  .btn--light:hover {
    background: var(--brass-soft);
    color: var(--green);
  }
  .btn--outline-light {
    border-color: rgb(255 255 255 / 0.45);
    color: #fff;
  }
  .btn--outline-light:hover {
    border-color: #fff;
    color: #fff;
  }
</style>
