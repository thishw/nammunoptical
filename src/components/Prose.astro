---
import type { Section } from '../data/services';
interface Props { sections: Section[] }
const { sections } = Astro.props;
---
{sections.map((s) => (
  <>
    <h2>{s.h}</h2>
    {s.p?.map((t) => <p>{t}</p>)}
    {s.list && <ol>{s.list.map((li) => {
      const [head, ...rest] = li.split(' — ');
      return rest.length ? <li><strong>{head}</strong> — {rest.join(' — ')}</li> : <li>{li}</li>;
    })}</ol>}
    {s.table && (
      <table>
        <thead><tr>{s.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{s.table.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
      </table>
    )}
  </>
))}
