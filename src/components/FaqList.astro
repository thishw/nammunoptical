---
import type { QA } from '../data/services';
interface Props { items: QA[]; openFirst?: boolean }
const { items, openFirst = false } = Astro.props;
---
<div class="faq">
  {items.map((f, i) => (
    <details open={openFirst && i === 0}>
      <summary>{f.q}</summary>
      <div class="answer"><p>{f.a}</p></div>
    </details>
  ))}
</div>
